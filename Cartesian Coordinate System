DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>3D Cartesian Coordinate System — Vector & Differential Simulator</title>

<style>
* {
    box-sizing: border-box;
}

html, body {
    margin: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    font-family: "Segoe UI", Arial, sans-serif;
    background: #111;
    color: white;
}

body {
    display: flex;
}

/* ================= SIDEBAR ================= */

#sidebar {
    width: 340px;
    min-width: 340px;
    background: #252526;
    padding: 18px;
    overflow-y: auto;
    box-shadow: 2px 0 12px rgba(0,0,0,0.45);
    z-index: 5;
}

h1 {
    font-size: 18px;
    margin: 0 0 12px;
    color: #00d1d9;
}

h2 {
    font-size: 14px;
    margin: 16px 0 9px;
    padding-bottom: 6px;
    border-bottom: 1px solid #444;
    color: #eee;
}

/* Information box */

.note {
    background: #333;
    padding: 10px;
    border-left: 4px solid #ff2e63;
    border-radius: 6px;
    font-size: 12px;
    line-height: 1.55;
}

/* Controls */

.row {
    display: grid;
    grid-template-columns: 58px 1fr 62px;
    gap: 7px;
    align-items: center;
    margin: 9px 0;
}

label {
    font-size: 12px;
    font-weight: 700;
}

input[type="range"] {
    width: 100%;
    accent-color: #00adb5;
}

input[type="number"] {
    width: 62px;
    background: #1c1c1c;
    color: white;
    border: 1px solid #555;
    border-radius: 4px;
    padding: 5px;
    text-align: center;
}

/* Buttons */

.buttons {
    display: flex;
    gap: 8px;
}

button {
    flex: 1;
    padding: 8px;
    border: none;
    border-radius: 5px;
    background: #3a3a3c;
    color: white;
    font-weight: 700;
    cursor: pointer;
}

button:hover {
    background: #4c4c4f;
}

.primary {
    background: #00adb5;
}

.primary:hover {
    background: #008e94;
}

/* Legend */

.legend {
    font-size: 12px;
    line-height: 1.8;
}

.swatch {
    display: inline-block;
    width: 11px;
    height: 11px;
    border-radius: 2px;
    margin-right: 7px;
}

/* ================= 3D STAGE ================= */

#stage {
    position: relative;
    flex: 1;
    min-width: 0;
    background: #101014;
}

#threeCanvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
}

/* ================= READOUT ================= */

#readout {
    position: absolute;
    top: 14px;
    right: 14px;

    background: rgba(0,0,0,0.7);

    padding: 12px 15px;
    border-radius: 8px;

    min-width: 250px;

    pointer-events: none;

    font-size: 12px;
    line-height: 1.7;
}

#readout b {
    font-size: 14px;
}

.badge {
    display: inline-block;
    padding: 2px 6px;
    border-radius: 4px;
    background: #333;
    margin-right: 4px;
}

/* Responsive */

@media(max-width:800px) {

    #sidebar {
        width: 290px;
        min-width: 290px;
    }

    .row {
        grid-template-columns: 52px 1fr 58px;
    }
}
</style>
</head>


<body>

<!-- =========================================================
     SIDEBAR
========================================================= -->

<aside id="sidebar">

    <h1>
        3D Cartesian Coordinate System
    </h1>


    <!-- Vector calculus information -->

    <div class="note">

        <b>Vector:</b>

        A =
        A<sub>x</sub>a<sub>x</sub>
        +
        A<sub>y</sub>a<sub>y</sub>
        +
        A<sub>z</sub>a<sub>z</sub>

        <br>

        <b>Differential:</b>

        dl =
        dx a<sub>x</sub>
        +
        dy a<sub>y</sub>
        +
        dz a<sub>z</sub>

        <br>

        <b>Points:</b>

        P(x,y,z)
        →
        P′(x+dx,y+dy,z+dz)

    </div>


    <!-- =====================================================
         VECTOR A
    ====================================================== -->

    <h2>
        Vector A — Point P (All 8 Octants)
    </h2>


    <!-- X -->

    <div class="row">

        <label style="color:#ff4136">
            Ax (X)
        </label>

        <input
            id="rangeX"
            type="range"
            min="-6"
            max="6"
            step="0.1"
            value="3.5"
        >

        <input
            id="numX"
            type="number"
            min="-6"
            max="6"
            step="0.1"
            value="3.5"
        >

    </div>


    <!-- Y -->

    <div class="row">

        <label style="color:#2ecc40">
            Ay (Y)
        </label>

        <input
            id="rangeY"
            type="range"
            min="-6"
            max="6"
            step="0.1"
            value="4"
        >

        <input
            id="numY"
            type="number"
            min="-6"
            max="6"
            step="0.1"
            value="4"
        >

    </div>


    <!-- Z -->

    <div class="row">

        <label style="color:#0074d9">
            Az (Z)
        </label>

        <input
            id="rangeZ"
            type="range"
            min="-6"
            max="6"
            step="0.1"
            value="4.5"
        >

        <input
            id="numZ"
            type="number"
            min="-6"
            max="6"
            step="0.1"
            value="4.5"
        >

    </div>


    <!-- =====================================================
         DIFFERENTIAL
    ====================================================== -->

    <h2>
        Differential dl — P → P′
    </h2>


    <!-- dx -->

    <div class="row">

        <label>
            dx
        </label>

        <input
            id="rangeDX"
            type="range"
            min="-3"
            max="3"
            step="0.1"
            value="1.5"
        >

        <input
            id="numDX"
            type="number"
            min="-3"
            max="3"
            step="0.1"
            value="1.5"
        >

    </div>


    <!-- dy -->

    <div class="row">

        <label>
            dy
        </label>

        <input
            id="rangeDY"
            type="range"
            min="-3"
            max="3"
            step="0.1"
            value="1.5"
        >

        <input
            id="numDY"
            type="number"
            min="-3"
            max="3"
            step="0.1"
            value="1.5"
        >

    </div>


    <!-- dz -->

    <div class="row">

        <label>
            dz
        </label>

        <input
            id="rangeDZ"
            type="range"
            min="-3"
            max="3"
            step="0.1"
            value="1.5"
        >

        <input
            id="numDZ"
            type="number"
            min="-3"
            max="3"
            step="0.1"
            value="1.5"
        >

    </div>


    <!-- =====================================================
         CAMERA CONTROLS
    ====================================================== -->

    <h2>
        Camera
    </h2>


    <div class="buttons">

        <button id="left">
            Rotate ↺
        </button>

        <button id="right">
            Rotate ↻
        </button>

    </div>


    <div
        class="buttons"
        style="margin-top:8px"
    >

        <button id="top">
            Top View
        </button>

        <button
            id="reset"
            class="primary"
        >
            Reset
        </button>

    </div>


    <!-- =====================================================
         LEGEND
    ====================================================== -->

    <h2>
        Legend
    </h2>


    <div class="legend">

        <div>
            <span
                class="swatch"
                style="background:#ff4136"
            ></span>

            X axis / a<sub>x</sub>
        </div>


        <div>
            <span
                class="swatch"
                style="background:#2ecc40"
            ></span>

            Y axis / a<sub>y</sub>
        </div>


        <div>
            <span
                class="swatch"
                style="background:#0074d9"
            ></span>

            Z axis / a<sub>z</sub>
        </div>


        <div>
            <span
                class="swatch"
                style="background:#f012be"
            ></span>

            Vector A (O → P)
        </div>


        <div>
            <span
                class="swatch"
                style="background:#ff851b"
            ></span>

            Vector dl (P → P′)
        </div>


        <div>
            <span
                class="swatch"
                style="background:#aaa"
            ></span>

            Dashed lines = projections
        </div>

    </div>

</aside>


<!-- =========================================================
     3D GRAPHICAL AREA
========================================================= -->

<main id="stage">

    <canvas id="threeCanvas"></canvas>


    <!-- Live coordinate display -->

    <div id="readout">

        <b>
            Live Coordinates
        </b>

        <br>


        <span class="badge">
            P
        </span>

        (
        <span id="pval">
            3.5, 4.0, 4.5
        </span>
        )

        <br>


        <span class="badge">
            P′
        </span>

        (
        <span id="ppval">
            5.0, 5.5, 6.0
        </span>
        )

        <br>


        <span class="badge">
            A
        </span>

        |A| =

        <span id="alen">
            7.02
        </span>

        <br>


        <span class="badge">
            dl
        </span>

        |dl| =

        <span id="dlen">
            2.60
        </span>

        <br>

        <span class="badge">
            dl1
        </span>

        =

        <span id="dl1val">
            dx aₓ + dy aᵧ
        </span>

        <br>

        <span class="badge">
            dl2
        </span>

        =

        <span id="dl2val">
            dy aᵧ + dz a𝓏
        </span>

    </div>

</main>


<!-- =========================================================
     THREE.JS
========================================================= -->

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>


<script>

/* =========================================================
   SCENE
========================================================= */

const canvas =
    document.getElementById("threeCanvas");


const scene =
    new THREE.Scene();


scene.background =
    new THREE.Color(0x101014);


/* =========================================================
   CAMERA
========================================================= */

const camera =
    new THREE.PerspectiveCamera(
        55,
        1,
        0.1,
        1000
    );


camera.position.set(
    12,
    10,
    14
);


/* =========================================================
   RENDERER
========================================================= */

const renderer =
    new THREE.WebGLRenderer({
        canvas: canvas,
        antialias: true
    });


renderer.setPixelRatio(
    Math.min(devicePixelRatio, 2)
);


/* =========================================================
   ORBIT CONTROLS
========================================================= */

const controls =
    new THREE.OrbitControls(
        camera,
        renderer.domElement
    );


controls.enableDamping = true;

controls.target.set(
    0,
    0,
    0
);


/* =========================================================
   LIGHTING
========================================================= */

scene.add(
    new THREE.AmbientLight(
        0xffffff,
        0.85
    )
);


const light =
    new THREE.DirectionalLight(
        0xffffff,
        0.8
    );


light.position.set(
    8,
    12,
    10
);


scene.add(light);


/* =========================================================
   AXIS FUNCTION
========================================================= */

function axis(
    direction,
    origin,
    color
) {

    const arrow =
        new THREE.ArrowHelper(

            new THREE.Vector3(
                ...direction
            ),

            new THREE.Vector3(
                ...origin
            ),

            8,

            color,

            0.5,

            0.28
        );

    scene.add(arrow);

    return arrow;
}


/* =========================================================
   AXES
========================================================= */

axis(
    [1,0,0],
    [-8,0,0],
    0xff4136
);


axis(
    [0,1,0],
    [0,-8,0],
    0x2ecc40
);


axis(
    [0,0,1],
    [0,0,-8],
    0x0074d9
);


/* =========================================================
   GRIDS
========================================================= */

const gridXY =
    new THREE.GridHelper(
        16,
        16,
        0x444444,
        0x222222
    );


scene.add(gridXY);


/* XZ grid */

const gridXZ =
    new THREE.GridHelper(
        16,
        16,
        0x333333,
        0x1d1d1d
    );


gridXZ.rotation.x =
    Math.PI / 2;


scene.add(gridXZ);


/* YZ grid */

const gridYZ =
    new THREE.GridHelper(
        16,
        16,
        0x333333,
        0x1d1d1d
    );


gridYZ.rotation.z =
    Math.PI / 2;


scene.add(gridYZ);


/* =========================================================
   TEXT LABEL FUNCTION
========================================================= */

function label(
    text,
    position,
    color
) {

    const canvas =
        document.createElement("canvas");


    canvas.width = 256;
    canvas.height = 128;


    const ctx =
        canvas.getContext("2d");


    ctx.font =
        "bold 72px Arial";


    ctx.fillStyle =
        color;


    ctx.textAlign =
        "center";


    ctx.textBaseline =
        "middle";


    ctx.fillText(
        text,
        128,
        64
    );


    const texture =
        new THREE.CanvasTexture(canvas);


    const sprite =
        new THREE.Sprite(

            new THREE.SpriteMaterial({
                map: texture,
                transparent: true
            })

        );


    sprite.position.set(
        ...position
    );


    sprite.scale.set(
        1.8,
        0.9,
        1
    );


    scene.add(sprite);
}


/* Axis labels */

label(
    "X",
    [8.5,0,0],
    "#ff4136"
);


label(
    "Y",
    [0,8.5,0],
    "#2ecc40"
);


label(
    "Z",
    [0,0,8.5],
    "#0074d9"
);


/* =========================================================
   DYNAMIC GROUP
========================================================= */

let group =
    new THREE.Group();


scene.add(group);


/* =========================================================
   CLICK-TO-EDIT POINT P ON THE GRAPH
========================================================= */

const raycaster = new THREE.Raycaster();
const mouse = new THREE.Vector2();

canvas.style.cursor = "crosshair";

canvas.addEventListener("click", (event) => {
    const rect = canvas.getBoundingClientRect();

    if (
        event.clientX < rect.left ||
        event.clientX > rect.right ||
        event.clientY < rect.top ||
        event.clientY > rect.bottom
    ) {
        return;
    }

    mouse.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
    mouse.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;

    raycaster.setFromCamera(mouse, camera);

    const plane = new THREE.Plane(new THREE.Vector3(0, 0, 1), 0);
    const pointOnPlane = new THREE.Vector3();
    raycaster.ray.intersectPlane(plane, pointOnPlane);

    if (pointOnPlane) {
        const newX = Math.max(-6, Math.min(6, pointOnPlane.x));
        const newY = Math.max(-6, Math.min(6, pointOnPlane.y));

        document.getElementById("numX").value = newX.toFixed(1);
        document.getElementById("rangeX").value = newX.toFixed(1);
        document.getElementById("numY").value = newY.toFixed(1);
        document.getElementById("rangeY").value = newY.toFixed(1);

        update();
    }
});


/* =========================================================
   ARROW FUNCTION
========================================================= */

function arrow(
    from,
    to,
    color,
    head = 0.35,
    width = 0.08
) {

    const f =
        new THREE.Vector3(
            ...from
        );


    const t =
        new THREE.Vector3(
            ...to
        );


    const direction =
        t.clone().sub(f);

    const length = direction.length();

    if (length < 0.0001) return; // Skip zero-length arrows


    const a =
        new THREE.ArrowHelper(

            direction.normalize(),

            f,

            length,

            color,

            head,

            width
        );


    group.add(a);

    return a;
}


/* =========================================================
   LINE FUNCTION
========================================================= */

function line(
    a,
    b,
    color = 0x777777,
    dashed = true
) {

    const geometry =
        new THREE.BufferGeometry()
        .setFromPoints([

            new THREE.Vector3(...a),

            new THREE.Vector3(...b)

        ]);


    let material;


    if (dashed) {

        material =
            new THREE.LineDashedMaterial({

                color: color,

                dashSize: 0.18,

                gapSize: 0.12,

                transparent: true,

                opacity: 0.8

            });

    }

    else {

        material =
            new THREE.LineBasicMaterial({
                color: color
            });

    }


    const l =
        new THREE.Line(
            geometry,
            material
        );


    if (dashed) {
        l.computeLineDistances();
    }


    group.add(l);

    return l;
}


/* =========================================================
   POINT FUNCTION
========================================================= */

function point(
    position,
    color
) {

    const mesh =
        new THREE.Mesh(

            new THREE.SphereGeometry(
                0.13,
                16,
                16
            ),

            new THREE.MeshBasicMaterial({
                color: color
            })

        );


    mesh.position.set(
        ...position
    );


    group.add(mesh);
}


/* =========================================================
   UPDATE GRAPHICS
========================================================= */

function update() {

    /* Read values */

    const x =
        +document.getElementById("numX").value || 0;


    const y =
        +document.getElementById("numY").value || 0;


    const z =
        +document.getElementById("numZ").value || 0;


    const dx =
        +document.getElementById("numDX").value || 0;


    const dy =
        +document.getElementById("numDY").value || 0;


    const dz =
        +document.getElementById("numDZ").value || 0;


    /* Points */

    const origin =
        [0,0,0];


    const P =
        [x,y,z];


    const P2 =
        [
            x + dx,
            y + dy,
            z + dz
        ];


    /* Clear previous drawing */

    group.clear();


    /* =====================================================
       VECTOR A
    ====================================================== */

    arrow(
        origin,
        P,
        0xf012be,
        0.45,
        0.11
    );


    point(
        P,
        0xf012be
    );


    /* =====================================================
       DIFFERENTIAL VECTOR dl
    ====================================================== */

    arrow(
        P,
        P2,
        0xff851b,
        0.42,
        0.1
    );


    point(
        P2,
        0xff851b
    );


    /* =====================================================
       DIFFERENTIAL COMPONENTS
    ====================================================== */

    const PX =
        [x + dx, y, z];


    const PXY =
        [x + dx, y + dy, z];


    /* dx component */

    line(
        P,
        PX,
        0xff4136
    );


    arrow(
        P,
        PX,
        0xff4136,
        0.18,
        0.055
    );


    /* dy component */

    line(
        PX,
        PXY,
        0x2ecc40
    );


    arrow(
        PX,
        PXY,
        0x2ecc40,
        0.18,
        0.055
    );


    /* dz component */

    arrow(
        PXY,
        P2,
        0x0074d9,
        0.18,
        0.055
    );


    /* =====================================================
       MAGNITUDES
    ====================================================== */

    const A =
        Math.hypot(
            x,
            y,
            z
        );


    const DL =
        Math.hypot(
            dx,
            dy,
            dz
        );


    /* =====================================================
       LIVE READOUT
    ====================================================== */

    document.getElementById("pval").textContent =
        `${x.toFixed(1)}, ${y.toFixed(1)}, ${z.toFixed(1)}`;


    document.getElementById("ppval").textContent =
        `${(x+dx).toFixed(1)}, ${(y+dy).toFixed(1)}, ${(z+dz).toFixed(1)}`;


    document.getElementById("alen").textContent =
        A.toFixed(2);


    document.getElementById("dlen").textContent =
        DL.toFixed(2);

    // dl1 and dl2 definitions
    document.getElementById("dl1val").textContent =
        `${dx.toFixed(2)} aₓ + ${dy.toFixed(2)} aᵧ`;

    document.getElementById("dl2val").textContent =
        `${dy.toFixed(2)} aᵧ + ${dz.toFixed(2)} a𝓏`;
}


/* =========================================================
   CONNECT SLIDERS WITH NUMBER INPUTS
========================================================= */

const pairs = [

    ["rangeX","numX"],

    ["rangeY","numY"],

    ["rangeZ","numZ"],

    ["rangeDX","numDX"],

    ["rangeDY","numDY"],

    ["rangeDZ","numDZ"]

];


pairs.forEach(
    ([rangeID, numberID]) => {

        const range =
            document.getElementById(rangeID);


        const number =
            document.getElementById(numberID);


        /* Slider → Number */

        range.addEventListener(
            "input",
            function() {

                number.value =
                    range.value;

                update();

            }
        );


        /* Number → Slider */

        number.addEventListener(
            "input",
            function() {

                range.value =
                    number.value;

                update();

            }
        );

    }
);


/* =========================================================
   RESIZE
========================================================= */

function resize() {

    const stage =
        document.getElementById("stage");


    const width =
        stage.clientWidth;


    const height =
        stage.clientHeight;


    renderer.setSize(
        width,
        height,
        false
    );


    camera.aspect =
        width / height;


    camera.updateProjectionMatrix();
}


window.addEventListener(
    "resize",
    resize
);


/* =========================================================
   CAMERA BUTTONS
========================================================= */

document
.getElementById("left")
.addEventListener(
    "click",
    function() {

        camera.position.applyAxisAngle(
            new THREE.Vector3(0,1,0),
            0.22
        );

        controls.update();
    }
);


document
.getElementById("right")
.addEventListener(
    "click",
    function() {

        camera.position.applyAxisAngle(
            new THREE.Vector3(0,1,0),
            -0.22
        );

        controls.update();
    }
);


/* =========================================================
   TOP VIEW
========================================================= */

document
.getElementById("top")
.addEventListener(
    "click",
    function() {

        camera.position.set(
            0,
            18,
            0.01
        );

        controls.target.set(
            0,
            0,
            0
        );

        controls.update();
    }
);


/* =========================================================
   RESET VIEW
========================================================= */

document
.getElementById("reset")
.addEventListener(
    "click",
    function() {

        camera.position.set(
            12,
            10,
            14
        );

        controls.target.set(
            0,
            0,
            0
        );

        controls.update();
    }
);


/* =========================================================
   INITIALIZE
========================================================= */

resize();

update();


/* =========================================================
   ANIMATION LOOP
========================================================= */

function animate() {

    requestAnimationFrame(
        animate
    );


    controls.update();


    renderer.render(
        scene,
        camera
    );
}


animate();

</script>

</body>
</html>
